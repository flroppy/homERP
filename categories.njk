---
layout: base.njk
title: Home Inventory
---

<h2>Browse Your Inventory</h2>

<div class="item-grid">
  {% for item in collections.allItems %}
    {% if item.url != '/' and not item.url.includes('/index.html') %}
      <div class="item-card">
        <h3><a href="{{ item.url }}">{{ item.data.name }}</a></h3>
        <p>
          {% if item.data.category %}Category: {{ item.data.category }}<br>{% endif %}
          {% if item.data.location %}Location: {{ item.data.location }}{% endif %}
        </p>
      </div>
    {% endif %}
  {% endfor %}
</div>
