# Copy this file to .env and fill in your values.

# App identity/hostname — only used if you set up a docker-compose.override.yml
# for reverse proxy labels, a homepage dashboard entry, etc.
NAME=homERP
URL=homERP.example.com

# Path to the directory where item data is stored (relative or absolute)
DATA_DIR=House

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# API key for /api/* endpoints. Leave empty to disable authentication.
API_KEY=

# Brother QL label printer settings. Leave BARCODE_PRINTER_ADDRESS empty to disable printing.
BARCODE_PRINTER_MODEL=QL-810W
BARCODE_PRINTER_ADDRESS=tcp://10.20.30.201
BARCODE_PRINTER_TAPE=12
BARCODE_RENDERED_HEIGHT=106

# Git backup — leave GIT_REMOTE_URL empty to disable
GIT_REMOTE_URL=
GIT_USERNAME=
GIT_TOKEN=
GIT_AUTHOR=homERP <homERP@s-d.space>
