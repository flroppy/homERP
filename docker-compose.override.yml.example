# Optional deployment-specific overrides — reverse proxy labels, custom
# networks, etc. Copy this to docker-compose.override.yml (gitignored);
# Docker Compose merges it into docker-compose.yaml automatically, no
# extra flags needed. Uses the same NAME/URL vars as .env.example.
services:
  homerp:
    container_name: ${NAME}
    networks:
      - proxy
      - internal
    labels:
      - "traefik.enable=true"
      - "traefik.http.services.${NAME}.loadbalancer.server.port=8000"
      - "traefik.http.routers.${NAME}.rule=Host(`${URL}`)"
      - "traefik.http.routers.${NAME}.entrypoints=web"
      - "traefik.http.routers.${NAME}.service=${NAME}"
      - "homepage.group=Home Management"
      - "homepage.name=${NAME}"
      - "homepage.icon=mdi-folder-home"
      - "homepage.href=http://${URL}"

networks:
  proxy:
    external: true
  internal:
    driver: bridge
